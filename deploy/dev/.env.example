# Labeled sandbox / AWS free-tier style single-box demo.
# Copy to deploy/dev/.env on the host (gitignored). Never production.

# Allow demo seed passwords + identity session projection on non-loopback.
SENTINEL_SANDBOX_PUBLIC_BIND=1
SENTINEL_V1_SANDBOX=1
IDENTITY_SANDBOX=1

# Shared seed password for all fixture accounts in services/identity/fixtures/seed_users.json
IDENTITY_DEMO_PASSWORD=demo-password

# Identity
IDENTITY_MODE=fixture
IDENTITY_HOST=0.0.0.0
IDENTITY_PORT=8012
# IDENTITY_DATABASE_URL=postgresql+psycopg://identity:identity@127.0.0.1:5432/identity

# Case API (portal sessions via identity /me)
SENTINEL_API_MODE=fixture
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8080
IDENTITY_BASE_URL=http://127.0.0.1:8012

# Web shell
NEXT_PUBLIC_SHELL_MODE=real-peers
NEXT_PUBLIC_VOICE_ENABLED=false
IDENTITY_BASE_URL=http://127.0.0.1:8012
CASE_API_BASE_URL=http://127.0.0.1:8080

# Sandbox accounts (password = IDENTITY_DEMO_PASSWORD):
# customer@example.test
# merchant@example.test
# operator@example.test
# supervisor@example.test
# risk@example.test
# admin@example.test
