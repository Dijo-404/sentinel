# Local fixture mode. Synthetic demo tokens only — never production credentials.
# Canonical sandbox matrix: integration/core/docs/sandbox-matrix.md
SENTINEL_API_MODE=fixture
SENTINEL_API_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel_api
# make seed: require SENTINEL_V1_SANDBOX=1 (or SENTINEL_API_SANDBOX=1); tenant-demo only
# SENTINEL_V1_SANDBOX=1
# SENTINEL_API_TENANT_ID=tenant-demo
SENTINEL_API_WORKFLOW_BASE_URL=http://127.0.0.1:8088
SENTINEL_API_EVIDENCE_BASE_URL=http://127.0.0.1:8006
SENTINEL_API_LEDGER_BASE_URL=http://127.0.0.1:8009
SENTINEL_API_VERIFIER_BASE_URL=http://127.0.0.1:8011
# JSON map of bearer token -> Principal (see fixtures/auth_tokens.json)
# Canonical: tok-workflow, tok-verifier, tok-case-api, tok-customer, tok-supervisor
SENTINEL_API_TOKEN_MAP_PATH=fixtures/auth_tokens.json
# Session/BFF principal projections (fixture double; fixture mode only)
SENTINEL_API_IDENTITY_SESSIONS_PATH=fixtures/identity_sessions.json
SENTINEL_API_SERVICE_TOKEN=tok-case-api
# Listen: make preview → 127.0.0.1:8080

# Real-peers: project human Authorization via identity GET /v1/auth/me.
# Shared name with apps/web and services/merchant-teams. Also accepted:
# SENTINEL_API_IDENTITY_BASE_URL=http://127.0.0.1:8012
# IDENTITY_BASE_URL=http://127.0.0.1:8012
# Non-loopback bind refused while identity session projection is enabled.

# SENTINEL_API_HOST=127.0.0.1  # non-loopback requires non-demo tokens in auth map + service_token

# Optional explicit legacy subject grants: tenant -> identity user ID -> subject refs.
# Customers without identity subject_refs or a configured binding have no subject grant.
# SENTINEL_API_IDENTITY_CUSTOMER_SUBJECT_BINDINGS={"tenant-demo":{"legacy-user-id":["subject-demo-42"]}}
