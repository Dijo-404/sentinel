# SN-012 / SN-038 web shell — public UI config only. No secrets.
# Canonical sandbox matrix: integration/core/docs/sandbox-matrix.md
# mode=fixture uses local stubs. mode=real-peers requires CASE_API_BASE_URL
# plus IDENTITY_BASE_URL for identity.v1.
#
# NEVER put real secrets in NEXT_PUBLIC_* — those values are bundled into the
# browser (ShellProvider is a client component). Portal case-api auth uses the
# httpOnly sentinel_session cookie via /api/bff/case/** — never a shared
# process-wide bearer in client shell config.
# Product demo: real-peers (BFF → peers → DB seed). Use fixture only for make check.
NEXT_PUBLIC_SHELL_MODE=real-peers
# Product demo: voice slot on. make check stays credential-free (no SARVAM).
NEXT_PUBLIC_VOICE_ENABLED=true
NEXT_PUBLIC_CONTRACT_VERSION=sentinel.task-contracts.v1
NEXT_PUBLIC_CONTRACT_SHA256=0db3ba2bba994f10d3060bc7173035360c15ffe23189cea409f7327e23c36feb

# Synthetic demo principal (fixture mode only). Never production credentials.
NEXT_PUBLIC_DEMO_ROLE=customer
NEXT_PUBLIC_DEMO_TOKEN=tok-customer

# Real-peer case API (required when NEXT_PUBLIC_SHELL_MODE=real-peers).
# Portal users: BFF forwards sentinel_session. CASE_API_BEARER_TOKEN is
# optional service-only fallback when no session cookie — do not rename to
# NEXT_PUBLIC_*. Failures stay visible; no silent fixture fallback.
# Listen: next dev --port 3012 → http://127.0.0.1:3012
CASE_API_BASE_URL=http://127.0.0.1:8080
# CASE_API_BEARER_TOKEN=tok-service

# Action ledger (required for supervisor getAction proposals in real-peers).
# Browser path: /api/bff/ledger/** with sentinel_session. Default sandbox :8009.
ACTION_LEDGER_BASE_URL=http://127.0.0.1:8009

# Identity peer (required when NEXT_PUBLIC_SHELL_MODE=real-peers).
# Default listen for services/identity: http://127.0.0.1:8012
# Auth + admin invite use server-only identity-client; supervisor Team uses
# BFF /api/bff/identity → IDENTITY_BASE_URL (GET /v1/ops/team).
# Fixture mode uses tests/stubs/identity (+ ops-team stub) and ignores this URL.
# Session cookies hold identity session_token server-side only — never NEXT_PUBLIC_*.
IDENTITY_BASE_URL=http://127.0.0.1:8012
# Sandbox auth challenge inbox (server-only; never NEXT_PUBLIC_*).
# Match identity IDENTITY_SANDBOX / SENTINEL_V1_SANDBOX + IDENTITY_SANDBOX_TOKEN.
# IDENTITY_SANDBOX=1
# SENTINEL_V1_SANDBOX=1
# IDENTITY_SANDBOX_TOKEN=local-demo-token

# Merchant analytics (required for real-peers merchant Analytics page + dashboard KPIs).
# BFF: /api/bff/merchant-analytics → MERCHANT_ANALYTICS_BASE_URL. Default preview: :8032
# Fixture mode uses tests/stubs/merchant-analytics. Real-peers: fail closed, no silent fixture.
MERCHANT_ANALYTICS_BASE_URL=http://127.0.0.1:8032

# Risk peer (optional; risk dashboard via /api/bff/risk).
# Default preview listen: http://127.0.0.1:8013
# Fixture mode uses tests/stubs/risk. Real-peers: fail closed.
RISK_BASE_URL=http://127.0.0.1:8013

# Merchant settlement (optional; findings list via /api/bff/merchant-settlement).
# Default preview listen: http://127.0.0.1:8027
# No silent fixture fallback in real-peers. Refunds have no list route — fixture-only in portal.
MERCHANT_SETTLEMENT_BASE_URL=http://127.0.0.1:8027

# Merchant disputes (list via /api/bff/merchant-disputes → GET /v1/merchants/{ref}/disputes).
# Default preview listen: http://127.0.0.1:8030
MERCHANT_DISPUTES_BASE_URL=http://127.0.0.1:8030

# Merchant inbox (exceptions via /api/bff/merchant-inbox → GET /v1/exceptions).
# Default preview listen: http://127.0.0.1:8028
# Tasks page fail-closed: inbox has no GET /v1/tasks (see merchant-sla for SLA tasks).
MERCHANT_INBOX_BASE_URL=http://127.0.0.1:8028

# Merchant teams (required for real-peers merchant Team page).
# BFF: /api/bff/merchant-teams → MERCHANT_TEAMS_BASE_URL. Default preview: :8034
# Fixture mode uses tests/stubs/merchant-teams. Real-peers: fail closed, no silent fixture.
MERCHANT_TEAMS_BASE_URL=http://127.0.0.1:8034

# Assistant (required for real-peers operator/customer Assistant pages).
# BFF: /api/bff/assistant → ASSISTANT_BASE_URL. Default preview: :8026
# Fixture mode uses tests/stubs/assistant. Real-peers: fail closed, no silent fixture.
ASSISTANT_BASE_URL=http://127.0.0.1:8026

# Knowledge (required for real-peers operator Knowledge page).
# BFF: /api/bff/knowledge → KNOWLEDGE_BASE_URL. Default preview: :8035
# (8034 = merchant-teams). Fixture stubs in tests/stubs/knowledge; real-peers fail closed.
KNOWLEDGE_BASE_URL=http://127.0.0.1:8035

# Ops activity (required for real-peers operator Activity page).
# BFF: /api/bff/ops-activity → OPS_ACTIVITY_BASE_URL. Default preview: :8029
# Fixture mode uses tests/stubs/ops-activity. Real-peers: fail closed, no silent fixture.
OPS_ACTIVITY_BASE_URL=http://127.0.0.1:8029

# Voice (optional; intake voice slot when NEXT_PUBLIC_VOICE_ENABLED=true).
# BFF: /api/bff/voice → VOICE_BASE_URL. Default preview: :8017
# Fixture mode uses tests/stubs/voice. Real-peers: fail closed, no silent fixture.
# SARVAM_API_KEY lives only in services/voice/.env — never here / never NEXT_PUBLIC_*.
VOICE_BASE_URL=http://127.0.0.1:8017

# Evals HTTP (evals/core report serve; admin Evaluations via /api/bff/evals).
# Default preview: :8031
EVALS_BASE_URL=http://127.0.0.1:8031

# Observability (admin Observability via /api/bff/observability).
# Default preview: :8033
OBSERVABILITY_BASE_URL=http://127.0.0.1:8033

# Platform AI (admin AI/integrations via /api/bff/platform-ai).
# Default preview: :8036
PLATFORM_AI_BASE_URL=http://127.0.0.1:8036

# Policy (admin Policies via /api/bff/policy). Default per services/policy: :8005
POLICY_BASE_URL=http://127.0.0.1:8005
