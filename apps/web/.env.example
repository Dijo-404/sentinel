# SN-012 web shell — public UI config only. No secrets.
# mode=fixture uses local stubs. mode=real-peers requires CASE_API_BASE_URL.
NEXT_PUBLIC_SHELL_MODE=fixture
NEXT_PUBLIC_VOICE_ENABLED=false
NEXT_PUBLIC_CONTRACT_VERSION=sentinel.task-contracts.v1
NEXT_PUBLIC_CONTRACT_SHA256=0c728513e8b4ec0f34bcef63faa0207160d45cc7f20f872c1d9136ca7e252ffa

# Synthetic demo principal (fixture mode). Never production credentials.
NEXT_PUBLIC_DEMO_ROLE=customer
NEXT_PUBLIC_DEMO_TOKEN=fixture-customer-token

# Real-peer case API (required when SHELL_MODE=real-peers). Failures stay visible.
CASE_API_BASE_URL=
CASE_API_BEARER_TOKEN=
