# Module-local assembly defaults. Never production credentials or live money.
# Canonical sandbox matrix: docs/sandbox-matrix.md + fixtures/sandbox-tokens.json (#84)
# Assembly extras: fixtures/sandbox-assembly.json (role_tokens, base_urls, journey_seeds)
CORE_ASSEMBLY_MODE=fixture
CORE_ASSEMBLY_CONTRACT_VERSION=sentinel.task-contracts.v1
CORE_ASSEMBLY_CONTRACT_SHA256=0db3ba2bba994f10d3060bc7173035360c15ffe23189cea409f7327e23c36feb
CORE_ASSEMBLY_TENANT_ID=tenant-demo
CORE_ASSEMBLY_CASE_ID=case-demo-42

# Strict real-peers mode: URLs/role tokens from fixtures/sandbox-assembly.json;
# identity principals from fixtures/sandbox-tokens.json (#84 shape).
# Fixture-mode defaults below; unset or override for real-peers (fixture URLs fail closed).
# CORE_ASSEMBLY_MODE=real-peers
# SENTINEL_V1_REQUIRE_FULL_PATH=1  # fail closed while path=provider-sandbox-only
CORE_ASSEMBLY_CASE_API_URL=http://127.0.0.1:8080
CORE_ASSEMBLY_WORKFLOW_URL=http://127.0.0.1:8088
CORE_ASSEMBLY_ACTION_LEDGER_URL=http://127.0.0.1:8009
CORE_ASSEMBLY_DISPATCHER_URL=http://127.0.0.1:8010
CORE_ASSEMBLY_VERIFIER_URL=http://127.0.0.1:8011
CORE_ASSEMBLY_PAYMENT_PROVIDER_URL=http://127.0.0.1:8094
CORE_ASSEMBLY_WEB_SHELL_URL=http://127.0.0.1:3012
# Optional RBAC peers (not REQUIRED_PEERS). Matrix defaults: identity 8012, risk 8013.
# Fixture probes use path=rbac-fixture; do not claim sn009_authority_exercised.
# CORE_ASSEMBLY_IDENTITY_URL=http://127.0.0.1:8012
# CORE_ASSEMBLY_RISK_URL=http://127.0.0.1:8013

# Shared opaque matrix tokens (same strings peers accept for each role).
# Synthetic only: tok-workflow / tok-case-api / tok-verifier / …
CORE_ASSEMBLY_TOKEN_WORKFLOW=tok-workflow
CORE_ASSEMBLY_TOKEN_DISPATCHER=tok-dispatcher
CORE_ASSEMBLY_TOKEN_VERIFIER=tok-verifier
CORE_ASSEMBLY_TOKEN_CASE_API=tok-case-api
CORE_ASSEMBLY_TOKEN_CUSTOMER=tok-customer
CORE_ASSEMBLY_TOKEN_OPERATOR=tok-operator
CORE_ASSEMBLY_TOKEN_SUPERVISOR=tok-supervisor
CORE_ASSEMBLY_TOKEN_PLATFORM_ADMIN=tok-platform-admin
CORE_ASSEMBLY_TOKEN_RISK_OFFICER=tok-risk-officer
CORE_ASSEMBLY_TOKEN_SANDBOX_ADMIN=tok-sandbox-admin
