# No secrets required for local fixture/recorded checks.
# Live-model mode is opt-in and remains labeled separately from fake/recorded scores.
FINBENCH_DATASET_VERSION=indic-fin-v0.1.0
FINBENCH_CONTRACT_VERSION=sentinel.task-contracts.v1
FINBENCH_MODE=recorded
# Optional real-peer endpoints (file path or http URL). Missing/malformed peers fail closed.
# FINBENCH_RUNTIME_PEER=
# FINBENCH_CONTEXT_PEER=
# FINBENCH_LIVE_MODEL=false
