# Local evaluation runner + optional HTTP report serve. No payment credentials.
EVALUATION_CONTRACT_VERSION=sentinel.task-contracts.v1
EVALUATION_MODE=fixture
EVALUATION_MODEL_MODE=fake
EVALUATION_CANDIDATE=conforming
EVALUATION_DATASET_VERSION=eval-fixtures-v1
# Real-peer HTTP candidate URL (unused in fixture self-test).
EVALUATION_CANDIDATE_URL=
# Assembly stub case for local peer doubles: valid|unavailable|malformed|unauthorized_or_out_of_scope|live
EVALUATION_ASSEMBLY_STUB=valid
# When ASSEMBLY_STUB=live, probe this core-assembly.v1 base URL (/healthz + /v1/capabilities).
EVALUATION_ASSEMBLY_URL=
# Opaque bearer map for HTTP report serve:
# token=principal_id|tenant_id|role1,role2|subject_a|case_a
EVALUATION_TOKENS=admin-token=admin-1|tenant-demo|platform_admin||;operator-token=op-1|tenant-demo|operator||
# Postgres (required for real-peers HTTP mode and make seed).
EVALUATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sentinel_evaluation
EVALUATION_HOST=127.0.0.1
EVALUATION_PORT=8031
