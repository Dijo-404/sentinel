# Module-local sandbox-validation defaults. Never production credentials or live money.
SANDBOX_PILOT_MODE=fixture
SANDBOX_PILOT_CONTRACT_VERSION=sentinel.task-contracts.v1
SANDBOX_PILOT_CONTRACT_SHA256=0c728513e8b4ec0f34bcef63faa0207160d45cc7f20f872c1d9136ca7e252ffa
# External pilot execution requires separate owner authorization. Fixture kit PASS is not pilot success.
SANDBOX_PILOT_EXTERNAL_AUTHORIZATION=false
# Strict real-peers mode: set endpoints for every required peer. Fixture URLs fail.
# SANDBOX_PILOT_CORE_ASSEMBLY_URL=http://127.0.0.1:8014
# SANDBOX_PILOT_FINHARNESS_RUNTIME_URL=http://127.0.0.1:8022
# SANDBOX_PILOT_FINBENCH_URL=http://127.0.0.1:8023
# SANDBOX_PILOT_HARNESS_TELEMETRY_URL=http://127.0.0.1:8024
# SANDBOX_PILOT_HARNESS_REPLAY_URL=http://127.0.0.1:8025
