# Secret server-side URL; provision a disposable sandbox locally, never production.
# Replace password outside version control. Environment files are not loaded automatically.
DATABASE_URL=postgresql+psycopg://demo_runtime:REPLACE_LOCALLY@127.0.0.1:5432/sentinel_demo_local
# Local sandbox configuration. Migrate as schema owner; seed/reset as sandbox admin.
PERSISTENCE_ENVIRONMENT=sandbox
PERSISTENCE_SCHEMA=demo_intake
PERSISTENCE_RUNTIME_ROLE=demo_runtime
# Server-authenticated tenant context in real callers; synthetic fixture here.
PERSISTENCE_TENANT_ID=demo-tenant-a
PERSISTENCE_CONTRACT_VERSION=sentinel.task-contracts.v1
