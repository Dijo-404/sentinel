    "Credit": {
      "type": "object",
      "properties": {
        "provider_ref": {
          "type": "string"
        },
        "confirmed": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        }
      },
      "required": [
        "provider_ref",
        "confirmed",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "PaymentFacts": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "PAYMENT"
        },
        "payment": {
          "$ref": "#/$defs/Payment"
        }
      },
      "required": [
        "kind",
        "payment"
      ],
      "additionalProperties": false
    },
    "OrderFacts": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ORDER"
        },
        "order": {
          "$ref": "#/$defs/Order"
        }
      },
      "required": [
        "kind",
        "order"
      ],
      "additionalProperties": false
    },
    "RefundFacts": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "REFUND"
        },
        "refund": {
          "$ref": "#/$defs/Refund"
        }
      },
      "required": [
        "kind",
        "refund"
      ],
      "additionalProperties": false
    },
    "CreditFacts": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "CREDIT"
        },
        "credit": {
          "$ref": "#/$defs/Credit"
        }
      },
      "required": [
        "kind",
        "credit"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "subject_ref": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_status": {
          "oneOf": [
            {
              "const": "VERIFIED"
            },
            {
              "const": "UNVERIFIED"
            },
            {
              "const": "CONFLICTING"
            }
          ]
        },
        "facts": {
          "oneOf": [
            {
              "$ref": "#/$defs/PaymentFacts"
            },
            {
              "$ref": "#/$defs/OrderFacts"
            },
            {
              "$ref": "#/$defs/RefundFacts"
            },
            {
              "$ref": "#/$defs/CreditFacts"
            }
          ]
        }
      },
      "required": [
        "evidence_id",
        "case_id",
        "source",
        "subject_ref",
        "observed_at",
        "expires_at",
        "digest",
        "verification_status",
        "facts"
      ],
      "additionalProperties": false
    },
    "EvidenceBundle": {
      "type": "object",
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "case_id": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "reconciliation_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contract_version",
        "case_id",
        "evidence",
        "reconciliation_codes"
      ],
      "additionalProperties": false
    },
    "ActionBase": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version"
      ],
      "additionalProperties": false
    },
    "RefundAction": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        },
        "action": {
          "const": "REQUEST_REFUND"
        },
        "transaction_ref": {
          "type": "string"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "INR"
        },
        "destination": {
          "const": "ORIGINAL_PAYMENT_ROUTE"
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version",
        "action",
        "transaction_ref",
        "amount_minor",
        "currency",
        "destination"
      ],
      "additionalProperties": false
    },
    "StatusAction": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        },
        "action": {
          "const": "STATUS_UPDATE"
        },
        "message_code": {
          "oneOf": [
            {
              "const": "WAITING"
            },
            {
              "const": "NEEDS_INPUT"
            },
            {
              "const": "ESCALATED"
            },
            {
              "const": "VERIFIED"
            }
          ]
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version",
        "action",
        "message_code"
      ],
      "additionalProperties": false
    },
    "DisputeAction": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        },
        "action": {
          "const": "OPEN_DISPUTE"
        },
        "transaction_ref": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version",
        "action",
        "transaction_ref",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "RecheckAction": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        },
        "action": {
          "const": "SCHEDULE_RECHECK"
        },
        "available_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "reason_code": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version",
        "action",
        "available_at",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "SyncAction": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        },
        "action": {
          "const": "SYNC_ORDER"
        },
        "transaction_ref": {
          "type": "string"
        },
        "order_reference": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version",
        "action",
        "transaction_ref",
        "order_reference"
      ],
      "additionalProperties": false
    },
    "EscalateAction": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "policy_version": {
          "type": "string"
        },
        "action": {
          "const": "ESCALATE"
        },
        "reason_code": {
          "type": "string"
        },
        "owner_queue": {
          "oneOf": [
            {
              "const": "PAYMENTS"
            },
            {
              "const": "FRAUD"
            },
            {
              "const": "SUPERVISOR"
            }
          ]
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "evidence_ids",
        "policy_version",
        "action",
        "reason_code",
        "owner_queue"
      ],
      "additionalProperties": false
    },
    "Action": {
      "oneOf": [
        {
          "$ref": "#/$defs/RefundAction"
        },
        {
          "$ref": "#/$defs/StatusAction"
        },
        {
          "$ref": "#/$defs/DisputeAction"
        },
        {
          "$ref": "#/$defs/RecheckAction"
        },
        {
          "$ref": "#/$defs/SyncAction"
        },
        {
          "$ref": "#/$defs/EscalateAction"
        }
      ]
    },
