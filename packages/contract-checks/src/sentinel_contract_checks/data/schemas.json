{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentinel:task-contracts:v1",
  "x-contract-version": "sentinel.task-contracts.v1",
  "x-baseline-sha256": "0db3ba2bba994f10d3060bc7173035360c15ffe23189cea409f7327e23c36feb",
  "$defs": {
    "Version": {
      "const": "sentinel.task-contracts.v1"
    },
    "Scope": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "case_id",
        "case_revision"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "customer",
              "operator",
              "supervisor",
              "workflow",
              "dispatcher",
              "verifier",
              "sandbox-admin"
            ]
          }
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "principal_id",
        "tenant_id",
        "roles",
        "subject_refs",
        "case_ids"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "additionalProperties": false
    },
    "Ack": {
      "type": "object",
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "job_id": {
          "type": "string"
        },
        "accepted": {
          "const": true
        }
      },
      "required": [
        "contract_version",
        "job_id",
        "accepted"
      ],
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "component": {
          "type": "string"
        },
        "mode": {
          "oneOf": [
            {
              "const": "fixture"
            },
            {
              "const": "real-peers"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "component",
        "mode"
      ],
      "additionalProperties": false
    },
    "Case": {
      "type": "object",
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "case_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/CaseState"
        },
        "language": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_id": {
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "case_id",
        "revision",
        "status",
        "language",
        "intent",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "CaseCreate": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "order_reference": {
          "type": "string"
        },
        "channel": {
          "oneOf": [
            {
              "const": "web"
            },
            {
              "const": "voice"
            }
          ]
        }
      },
      "required": [
        "message",
        "language",
        "order_reference",
        "channel"
      ],
      "additionalProperties": false
    },
    "CaseCreated": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "status": {
          "const": "RECEIVED"
        },
        "status_url": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "status",
        "status_url"
      ],
      "additionalProperties": false
    },
    "CaseMessage": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "author": {
          "oneOf": [
            {
              "const": "CUSTOMER"
            },
            {
              "const": "OPERATOR"
            }
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        }
      },
      "required": [
        "message_id",
        "text",
        "language",
        "author",
        "occurred_at"
      ],
      "additionalProperties": false
    },
    "CaseInput": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "original_text": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "order_reference": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseMessage"
          }
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "original_text",
        "language",
        "order_reference",
        "messages"
      ],
      "additionalProperties": false
    },
    "CaseEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "case_id": {
          "type": "string"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/CaseState"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "action_id": {
              "type": "string"
            },
            "reason_code": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "evidence_ids",
            "reason_code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "sequence",
        "case_id",
        "case_revision",
        "type",
        "occurred_at",
        "payload"
      ],
      "additionalProperties": false
    },
    "CaseResult": {
      "type": "object",
      "properties": {
        "event_key": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/CaseState"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_id": {
          "type": "string"
        },
        "assessment_id": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        }
      },
      "required": [
        "event_key",
        "expected_revision",
        "status",
        "evidence_ids",
        "reason_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED_RESOLVED"
              }
            }
          },
          "then": {
            "required": [
              "assessment_id"
            ]
          }
        }
      ]
    },
    "Payment": {
      "type": "object",
      "properties": {
        "transaction_ref": {
          "type": "string"
        },
        "order_reference": {
          "type": "string"
        },
        "subject_ref": {
          "type": "string"
        },
        "status": {
          "oneOf": [
            {
              "const": "CAPTURED"
            },
            {
              "const": "PENDING"
            },
            {
              "const": "FAILED"
            }
          ]
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "INR"
        }
      },
      "required": [
        "transaction_ref",
        "order_reference",
        "subject_ref",
        "status",
        "amount_minor",
        "currency"
      ],
      "additionalProperties": false
    },
    "Order": {
      "type": "object",
      "properties": {
        "order_reference": {
          "type": "string"
        },
        "subject_ref": {
          "type": "string"
        },
        "fulfilled_order_count": {
          "type": "integer",
          "minimum": 0
        },
        "merchant_confirmed_duplicate": {
          "type": "boolean"
        },
        "paid": {
          "type": "boolean"
        }
      },
      "required": [
        "order_reference",
        "subject_ref",
        "fulfilled_order_count",
        "merchant_confirmed_duplicate",
        "paid"
      ],
      "additionalProperties": false
    },
    "RefundRequest": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "provider_ref": {
          "type": "string"
        },
        "transaction_ref": {
          "type": "string"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "INR"
        },
        "destination": {
          "const": "ORIGINAL_PAYMENT_ROUTE"
        }
      },
      "required": [
        "action_id",
        "provider_ref",
        "transaction_ref",
        "amount_minor",
        "currency",
        "destination"
      ],
      "additionalProperties": false
    },
    "Refund": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "provider_ref": {
          "type": "string"
        },
        "transaction_ref": {
          "type": "string"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "INR"
        },
        "status": {
          "oneOf": [
            {
              "const": "PENDING"
            },
            {
              "const": "PROVIDER_CONFIRMED"
            },
            {
              "const": "FAILED_FINAL"
