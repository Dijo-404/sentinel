# Module-local configuration. Environment files are documentation only; export locally.
# Fake mode is the default. Live Sarvam calls stay opt-in and never fall back to fixtures.

INDIC_CONTEXT_MODE=fake
INDIC_CONTEXT_FAKE_SCENARIO=proposal
INDIC_CONTEXT_HOST=127.0.0.1
INDIC_CONTEXT_PORT=8091
INDIC_CONTEXT_POLICY_VERSION=demo-policy-v1
INDIC_CONTEXT_CONTRACT_VERSION=sentinel.task-contracts.v1

# Synthetic bearer map for local demos (never production credentials).
INDIC_CONTEXT_AUTH_TOKENS={"workflow-token":{"principal_id":"svc-workflow","tenant_id":"tenant-demo","roles":["workflow"],"subject_refs":["subject-demo"],"case_ids":["case-demo-42"]}}

# Live provider (only when INDIC_CONTEXT_MODE=live). Failures stay visible; no fixture fallback.
INDIC_CONTEXT_SARVAM_BASE_URL=https://api.sarvam.ai
INDIC_CONTEXT_SARVAM_MODEL_ID=sarvam-m
INDIC_CONTEXT_SARVAM_API_KEY=
INDIC_CONTEXT_SARVAM_TIMEOUT_SECONDS=20
INDIC_CONTEXT_NATIVE_REVIEW_LIMIT=human-review-required-for-refunds
