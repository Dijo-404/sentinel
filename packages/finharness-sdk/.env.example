# FinHarness routing is disabled by default. No secrets are required for local fixture checks.
# These values are documentation only; the SDK does not auto-load .env files.
FINHARNESS_ENABLED=false
FINHARNESS_EXECUTION_MODE=legacy
FINHARNESS_FINANCIAL_WRITES=false
FINHARNESS_NOTIFICATIONS=false
FINHARNESS_CONTRACT_VERSION=sentinel.task-contracts.v1
FINHARNESS_MANIFEST=fixtures/case-manifest.json
