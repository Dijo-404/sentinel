# Module-local configuration. Environment files are documentation only; export locally.
# Default mode uses in-process stubs/templates. Real peer URLs stay opt-in.

MERCHANT_COMMS_MODE=fixture
MERCHANT_COMMS_HOST=127.0.0.1
MERCHANT_COMMS_PORT=8093
MERCHANT_COMMS_CONTRACT_VERSION=sentinel.task-contracts.v1
MERCHANT_COMMS_DEFAULT_CHANNEL=merchant-portal

# Synthetic bearer map for local demos (never production credentials).
MERCHANT_COMMS_AUTH_TOKENS={"operator-token":{"principal_id":"op-demo","tenant_id":"tenant-demo","roles":["operator"],"subject_refs":["subject-demo"],"case_ids":["case-demo-42"]},"supervisor-token":{"principal_id":"sup-demo","tenant_id":"tenant-demo","roles":["supervisor"],"subject_refs":["subject-demo"],"case_ids":["case-demo-42"]}}

# Optional real-peer endpoints. Empty means optional indic falls back to labeled fake templates.
MERCHANT_COMMS_CASE_API_BASE_URL=
MERCHANT_COMMS_CASE_API_TOKEN=
MERCHANT_COMMS_INDIC_CONTEXT_BASE_URL=
MERCHANT_COMMS_INDIC_CONTEXT_TOKEN=

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
