# ops-activity.v1 — synthetic local config only.
OPS_ACTIVITY_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-memory store; real-peers = Postgres required (fail closed).
OPS_ACTIVITY_MODE=fixture
# Opaque bearer map: token=principal_id|tenant_id|role1,role2
OPS_ACTIVITY_TOKENS=operator-token=op-1|tenant-demo|operator;supervisor-token=sup-1|tenant-demo|supervisor
# Postgres activity rows (required in real-peers). make seed writes tenant-demo case-demo-42.
OPS_ACTIVITY_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sentinel_ops_activity
OPS_ACTIVITY_HOST=127.0.0.1
OPS_ACTIVITY_PORT=8029

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
