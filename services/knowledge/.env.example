# Knowledge articles service (knowledge.v1). Synthetic / sandbox only.
KNOWLEDGE_ENVIRONMENT=sandbox
KNOWLEDGE_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-process memory store; real-peers = Postgres required (fail closed).
KNOWLEDGE_MODE=fixture
# Opaque bearer token map:
# token=principal_id|tenant_id|role1,role2|subject_a,subject_b
KNOWLEDGE_TOKENS=operator-token=op-1|tenant-demo|operator|subj-demo-1;supervisor-token=sup-1|tenant-demo|supervisor|subj-demo-1
# Durable store. Required for `make seed` and for real-peers (or inject a store).
# When set, bootstrap uses PostgresArticleStore (fixture mode included).
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge:knowledge@127.0.0.1:5432/sentinel_knowledge
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=8028

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
