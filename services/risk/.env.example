# Risk & fraud service (risk.v1). Synthetic / sandbox only.
RISK_ENVIRONMENT=sandbox
RISK_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-process case-api + workflow stubs; real-peers = HTTP peers (fail closed).
RISK_MODE=fixture
# Opaque bearer token map:
# token=principal_id|tenant_id|role1,role2|subject_a|case_a,case_b|queue_a
RISK_TOKENS=risk-token=risk-1|tenant-demo|risk_officer|subj-demo-1|case-demo-42,case-fraud-99|FRAUD;tok-risk-officer=risk-officer-demo|tenant-demo|risk_officer|subject-demo-42|case-demo-42|FRAUD;tok-workflow=svc-workflow|tenant-demo|workflow|subject-demo-42|*|
# Required only when RISK_MODE=real-peers. No silent fixture fallback.
CASE_API_BASE_URL=http://127.0.0.1:18007
CASE_API_TOKEN=REPLACE_LOCALLY
WORKFLOW_BASE_URL=http://127.0.0.1:8088
WORKFLOW_TOKEN=tok-risk-officer
# Optional durable store. Required (or injected store) for real-peers.
# RISK_DATABASE_URL=postgresql+psycopg://risk:risk@127.0.0.1:5432/sentinel_risk
RISK_HOST=127.0.0.1
RISK_PORT=8013

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
