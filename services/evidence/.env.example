# Secret server-side URL; provision a disposable sandbox locally, never production.
# Canonical sandbox matrix: integration/core/docs/sandbox-matrix.md
# Required unless EVIDENCE_MODE=fixture or SENTINEL_EVIDENCE_ALLOW_MEMORY=1.
DATABASE_URL=postgresql+psycopg://evidence_runtime:REPLACE_LOCALLY@127.0.0.1:5432/sentinel_evidence_local
EVIDENCE_ENVIRONMENT=sandbox
EVIDENCE_SCHEMA=evidence
EVIDENCE_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-process stub provider (+ memory store without DATABASE_URL);
# real-peers = HTTP payment-provider.v1 (fail closed; requires DATABASE_URL or ALLOW_MEMORY).
EVIDENCE_MODE=fixture
# SENTINEL_EVIDENCE_ALLOW_MEMORY=1
# Required only when EVIDENCE_MODE=real-peers. No silent fixture fallback.
PAYMENT_PROVIDER_BASE_URL=http://127.0.0.1:8094
PAYMENT_PROVIDER_TOKEN=tok-workflow
# Opaque bearer token map: token=principal_id|tenant_id|role1,role2|subject_a,subject_b|case_a,case_b
# Empty case list denies; use * for all cases. Canonical tok-* plus legacy aliases.
EVIDENCE_TOKENS=tok-workflow=svc-workflow|tenant-demo|workflow|subject-demo-42|case-demo-42;tok-verifier=svc-verifier|tenant-demo|verifier|subject-demo-42|case-demo-42;workflow-token=svc-workflow|tenant-demo|workflow|subj-demo-1|case-demo-42;verifier-token=svc-verifier|tenant-demo|verifier|subj-demo-1|case-demo-42;operator-token=op-1|tenant-demo|operator|subj-demo-1|case-demo-42
EVIDENCE_TTL_SECONDS=3600
# Listen: sentinel-evidence serve --port 8006
