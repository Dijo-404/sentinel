# Model gateway (Sarvam AI). Put real values in a gitignored .env; never commit the key.
SARVAM_API_KEY=
MODEL_GATEWAY_MODEL=sarvam-105b
MODEL_GATEWAY_SARVAM_BASE_URL=https://api.sarvam.ai
MODEL_GATEWAY_MAX_TOKENS=4096
# off|low|medium|high. Callers time out at 10s; reasoning on measured 15-54s live, so keep off.
MODEL_GATEWAY_REASONING_EFFORT=off
MODEL_GATEWAY_SARVAM_TIMEOUT_S=9
# Comma-separated bearer tokens accepted on POST /v1/proposals (workflow WORKFLOW_OUTBOUND_BEARER).
MODEL_GATEWAY_TOKENS=tok-workflow
# knowledge.v1 search used to ground POST /v1/replies. Token needs operator or supervisor role.
MODEL_GATEWAY_KNOWLEDGE_URL=http://127.0.0.1:8035
MODEL_GATEWAY_KNOWLEDGE_TOKEN=operator-token
MODEL_GATEWAY_HOST=127.0.0.1
MODEL_GATEWAY_PORT=8040

# Non-loopback bind refuses demo bearer tokens. /v1/replies is unauthenticated (see README).
