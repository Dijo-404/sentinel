# SN-032 merchant-analytics.v1 — synthetic local config only.
MERCHANT_ANALYTICS_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-process case/evidence stubs; real-peers = DB snapshots and/or HTTP peers (fail closed).
MERCHANT_ANALYTICS_MODE=fixture
# Opaque bearer map:
# token=principal_id|tenant_id|role1,role2|subject_a,subject_b|case_a,case_b|merchant_a,merchant_b
# Empty merchant list denies; * allows all merchants in tenant. Deny-by-default.
MERCHANT_ANALYTICS_TOKENS=operator-token=op-1|tenant-demo|operator|subj-demo-1|*|merchant-demo-1;supervisor-token=sup-1|tenant-demo|supervisor|subj-demo-1|*|merchant-demo-1
# Postgres metrics snapshots (preferred in real-peers). make seed writes merchant-demo-1 matrix window.
MERCHANT_ANALYTICS_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sentinel_merchant_analytics
# Required only when MERCHANT_ANALYTICS_MODE=real-peers and MERCHANT_ANALYTICS_DATABASE_URL is unset.
# No silent fixture fallback.
CASE_API_BASE_URL=http://127.0.0.1:18007
CASE_API_TOKEN=REPLACE_LOCALLY
EVIDENCE_BASE_URL=http://127.0.0.1:18006
EVIDENCE_TOKEN=REPLACE_LOCALLY

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
