# Documentation only. Export through the local shell/secret manager.
# DATABASE_URL is secret server-side configuration (postgresql+psycopg://...).
DATABASE_URL=postgresql+psycopg://dispatcher_runtime:REPLACE_LOCALLY@127.0.0.1:5432/sentinel_demo_dispatcher
DISPATCHER_SCHEMA=dispatcher
DISPATCHER_ENVIRONMENT=sandbox
DISPATCHER_TENANT_ID=demo-tenant-a
DISPATCHER_CONTRACT_VERSION=sentinel.task-contracts.v1
DISPATCHER_MODE=fixture
# Real-peer base URLs (never used by fixture make check).
LEDGER_BASE_URL=http://127.0.0.1:18009
PROVIDER_BASE_URL=http://127.0.0.1:18004
DISPATCHER_BEARER_TOKEN=synthetic-dispatcher-token
