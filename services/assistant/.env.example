# Assistant service (assistant.v1). Synthetic / sandbox only.
ASSISTANT_ENVIRONMENT=sandbox
ASSISTANT_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-process memory store; real-peers = requires ASSISTANT_DATABASE_URL.
ASSISTANT_MODE=fixture
# Opaque bearer token map: token=principal_id|tenant_id|roles
ASSISTANT_TOKENS=tok-customer=customer-demo|tenant-demo|customer;operator-token=operator-demo|tenant-demo|operator
# Durable store. Required for `make seed` and for real-peers (or inject a store).
# When set, bootstrap uses PostgresAssistantStore (fixture mode included).
ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:assistant@127.0.0.1:5432/sentinel_assistant
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8026

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
