# Local sandbox only. Never production payment credentials.
# Canonical matrix: integration/core/docs/sandbox-matrix.md
DATABASE_URL=postgresql+psycopg://ledger_runtime:REPLACE_LOCALLY@127.0.0.1:5432/sentinel_ledger_local
LEDGER_ENVIRONMENT=sandbox
LEDGER_CONTRACT_VERSION=sentinel.task-contracts.v1
LEDGER_MODE=fixture
LEDGER_LEASE_SECONDS=300
# Synthetic demo tokens → Principal map (server-side only). Canonical + legacy aliases.
LEDGER_TOKEN_WORKFLOW=tok-workflow
LEDGER_TOKEN_SUPERVISOR=tok-supervisor
LEDGER_TOKEN_DISPATCHER=tok-dispatcher
LEDGER_TOKEN_VERIFIER=tok-verifier
LEDGER_TENANT_ID=tenant-demo
# Real-peer URLs required only when LEDGER_MODE=real-peers.
POLICY_BASE_URL=http://127.0.0.1:8005
EVIDENCE_BASE_URL=http://127.0.0.1:8006
# Listen: 127.0.0.1:8009

# Non-loopback bind (0.0.0.0 / LAN IP) requires non-demo bearer tokens; loopback may keep tok-* defaults.
