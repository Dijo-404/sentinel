# Local sandbox only. Never production payment credentials.
DATABASE_URL=postgresql+psycopg://ledger_runtime:REPLACE_LOCALLY@127.0.0.1:5432/sentinel_ledger_local
LEDGER_ENVIRONMENT=sandbox
LEDGER_CONTRACT_VERSION=sentinel.task-contracts.v1
LEDGER_MODE=fixture
LEDGER_LEASE_SECONDS=300
# Synthetic demo tokens → Principal map (server-side only).
LEDGER_TOKEN_WORKFLOW=token-workflow-demo
LEDGER_TOKEN_SUPERVISOR=token-supervisor-demo
LEDGER_TOKEN_DISPATCHER=token-dispatcher-demo
LEDGER_TOKEN_VERIFIER=token-verifier-demo
LEDGER_TOKEN_OPERATOR=token-operator-demo
LEDGER_TENANT_ID=tenant-demo-1
# Real-peer URLs required only when LEDGER_MODE=real-peers.
POLICY_BASE_URL=
EVIDENCE_BASE_URL=
