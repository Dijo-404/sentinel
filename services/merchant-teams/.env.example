# Fixture mode uses in-process case-api + identity stubs. Real-peers require CASE_API_*.
MERCHANT_TEAMS_MODE=fixture
MERCHANT_TEAMS_CONTRACT_VERSION=sentinel.task-contracts.v1
# Opaque bearer map: token=principal_id|tenant_id|role1,role2|merchant_a,merchant_b|case_a,case_b
# subject_refs hold merchant_ref scope. Empty denies; * grants all merchants for the tenant.
MERCHANT_TEAMS_TOKENS=operator-token=op-1|tenant-demo|operator|merchant-demo-1|case-demo-42;supervisor-token=sup-1|tenant-demo|supervisor|merchant-demo-1,*|case-demo-42;outsider-token=op-other|tenant-other|operator|merchant-other|case-other
# Required only when MERCHANT_TEAMS_MODE=real-peers. No silent fixture fallback.
CASE_API_BASE_URL=http://127.0.0.1:18007
CASE_API_TOKEN=REPLACE_LOCALLY
# Optional in real-peers: when set, membership sync fetches identity.v1 and fails closed.
# IDENTITY_BASE_URL=http://127.0.0.1:8012
# IDENTITY_TOKEN=REPLACE_LOCALLY

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
