# Local fixture-mode voice adapter. Never put production Sarvam keys here.
VOICE_HOST=127.0.0.1
VOICE_PORT=8017
VOICE_MODE=fixture
VOICE_CONTRACT_VERSION=sentinel.task-contracts.v1
VOICE_PRINCIPALS_PATH=contracts/principals.json
VOICE_FIXTURES_PATH=fixtures/sarvam
# Retention: none (default local) | ephemeral | restricted
VOICE_RETENTION_MODE=none
# Live Sarvam is opt-in only. Leave unset for make check.
# VOICE_MODE=real-peers
# SARVAM_API_KEY=
# SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
# SARVAM_STT_MODEL=saaras:v4
