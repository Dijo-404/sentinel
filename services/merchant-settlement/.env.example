# Local fixture-mode merchant settlement. Tokens are synthetic demo credentials, never production.
MERCHANT_SETTLEMENT_HOST=127.0.0.1
MERCHANT_SETTLEMENT_PORT=8027
MERCHANT_SETTLEMENT_MODE=fixture
MERCHANT_SETTLEMENT_CONTRACT_VERSION=sentinel.task-contracts.v1
# Opaque bearer token map is loaded from contracts/principals.json by default.
MERCHANT_SETTLEMENT_PRINCIPALS_PATH=contracts/principals.json
# Required only when MERCHANT_SETTLEMENT_MODE=real-peers. No silent fixture fallback.
EVIDENCE_BASE_URL=http://127.0.0.1:8006
EVIDENCE_TOKEN=REPLACE_LOCALLY
PAYMENT_PROVIDER_BASE_URL=http://127.0.0.1:18004
PAYMENT_PROVIDER_TOKEN=REPLACE_LOCALLY

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
