# Merchant dispute management (merchant-disputes.v1). Synthetic / sandbox only.
DISPUTES_ENVIRONMENT=sandbox
DISPUTES_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-process case-api + evidence stubs; real-peers = HTTP peers (fail closed).
DISPUTES_MODE=fixture
# Opaque bearer token map:
# token=principal_id|tenant_id|role1,role2|subject_a|case_a,case_b|merchant_ref
DISPUTES_TOKENS=operator-token=op-1|tenant-demo|operator|subj-demo-1|case-demo-42|merchant-demo;supervisor-token=sup-1|tenant-demo|supervisor|subj-demo-1|case-demo-42|merchant-demo
# Required only when DISPUTES_MODE=real-peers. No silent fixture fallback.
CASE_API_BASE_URL=http://127.0.0.1:18007
CASE_API_TOKEN=REPLACE_LOCALLY
EVIDENCE_BASE_URL=http://127.0.0.1:18006
EVIDENCE_TOKEN=REPLACE_LOCALLY
# Default dispute response window when create omits deadline_at (seconds).
DISPUTES_DEFAULT_DEADLINE_SECONDS=604800
# Durable store: PostgreSQL preferred for sandbox/real-peers; sqlite:/// still accepted.
# DISPUTES_DATABASE_URL=postgresql+psycopg://disputes:disputes@127.0.0.1:5432/sentinel_disputes
# DISPUTES_DATABASE_URL=sqlite:///./merchant-disputes.db
# Sandbox seed (make seed): tenant-demo only + SENTINEL_V1_SANDBOX or DISPUTES_SANDBOX.
DISPUTES_TENANT_ID=tenant-demo
SENTINEL_V1_SANDBOX=1
# DISPUTES_SANDBOX=1
DISPUTES_HOST=127.0.0.1
DISPUTES_PORT=8030

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
