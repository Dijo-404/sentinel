# observability.v1 — synthetic local config only.
OBSERVABILITY_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-memory store; real-peers = Postgres required (fail closed).
OBSERVABILITY_MODE=fixture
# Opaque bearer map: token=principal_id|tenant_id|role1,role2
OBSERVABILITY_TOKENS=admin-token=admin-1|tenant-demo|platform_admin;sandbox-admin-token=admin-sandbox|tenant-demo|sandbox-admin
# Postgres signal rows (required in real-peers). make seed writes tenant-demo span.
OBSERVABILITY_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sentinel_observability
OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=8033

# Non-loopback bind requires non-demo bearer tokens; loopback may keep demo defaults.
