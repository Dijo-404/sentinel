# SN-022 finharness-runtime — local fixture mode.
# No production payment credentials. Shadow path has no write adapter.
SENTINEL_FHR_MODE=fixture
SENTINEL_FHR_STATE_DIR=.finharness-runtime-state
SENTINEL_FHR_RUNTIME_VERSION=finharness-runtime.v1
SENTINEL_FHR_EXECUTION_MODE=shadow
SENTINEL_FHR_ENABLED=true
SENTINEL_FHR_FINANCIAL_WRITES=false
SENTINEL_FHR_NOTIFICATIONS=false
SENTINEL_FHR_ROLLOUT_PERCENT=100
SENTINEL_FHR_ALLOWED_TENANTS=sandbox
# Real peer base URLs left unset: real-peers mode fails closed.
# SENTINEL_FHR_EVIDENCE_URL=
# SENTINEL_FHR_POLICY_URL=
# SENTINEL_FHR_LEDGER_URL=
# SENTINEL_FHR_VERIFIER_URL=
# SENTINEL_FHR_INDIC_CONTEXT_URL=
# SENTINEL_FHR_SDK_URL=
