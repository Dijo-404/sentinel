# Documentation only. Export through the local shell/secret manager.
# Canonical sandbox matrix: integration/core/docs/sandbox-matrix.md
# DATABASE_URL is secret server-side configuration (postgresql+psycopg://...).
DATABASE_URL=postgresql+psycopg://verifier_runtime:REPLACE_LOCALLY@127.0.0.1:5432/sentinel_demo_verifier
VERIFIER_SCHEMA=verifier
VERIFIER_ENVIRONMENT=sandbox
VERIFIER_TENANT_ID=tenant-demo
VERIFIER_CONTRACT_VERSION=sentinel.task-contracts.v1
VERIFIER_MODE=fixture
# HMAC key for simulator webhook original-byte signatures (synthetic local only).
VERIFIER_WEBHOOK_HMAC_KEY=demo-simulator-hmac-key
# Merchant → tenant map entries as merchant_ref=tenant_id pairs, comma-separated.
VERIFIER_MERCHANT_MAP=merchant-demo-1=tenant-demo
# Real-peer base URLs (never used by fixture make check).
PROVIDER_BASE_URL=http://127.0.0.1:8094
LEDGER_BASE_URL=http://127.0.0.1:8009
EVIDENCE_BASE_URL=http://127.0.0.1:8006
CASE_API_BASE_URL=http://127.0.0.1:8080
VERIFIER_BEARER_TOKEN=tok-verifier
# Listen: 127.0.0.1:8011

# Non-loopback bind (0.0.0.0 / LAN IP) requires non-demo bearer tokens; loopback may keep tok-* defaults.
