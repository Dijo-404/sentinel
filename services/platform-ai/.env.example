# platform-ai.v1 — synthetic local config only. No money authority.
PLATFORM_AI_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture = in-memory store; real-peers = Postgres required (fail closed).
PLATFORM_AI_MODE=fixture
# Opaque bearer map:
# token=principal_id|tenant_id|role1,role2|subject_a|case_a
PLATFORM_AI_TOKENS=admin-token=admin-1|tenant-demo|platform_admin||;operator-token=op-1|tenant-demo|operator||
# Postgres (required for real-peers and make seed).
PLATFORM_AI_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sentinel_platform_ai
PLATFORM_AI_HOST=127.0.0.1
PLATFORM_AI_PORT=8036
