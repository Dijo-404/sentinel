# Local fixture-mode policy service. Tokens are synthetic demo credentials, never production.
POLICY_HOST=127.0.0.1
POLICY_PORT=8005
POLICY_MODE=fixture
POLICY_CONTRACT_VERSION=sentinel.task-contracts.v1
POLICY_VERSION=demo-policy-v1
# Opaque bearer token map is loaded from contracts/principals.json by default.
POLICY_PRINCIPALS_PATH=contracts/principals.json
