# Synthetic demo tokens only. Never production payment credentials.
# Canonical sandbox matrix: integration/core/docs/sandbox-matrix.md
# Environment files are documentation; export values locally (not auto-loaded).
SIMULATOR_CONTRACT_VERSION=sentinel.task-contracts.v1
# fixture | real-peers — assembly probe may require real-peers; never means live rails.
SIMULATOR_MODE=real-peers
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=8094
SIMULATOR_BASE_URL=http://127.0.0.1:8094

# Sandbox gate for demo-reset (required true; refuses non-sandbox / non tenant-demo).
SIMULATOR_SANDBOX=true
# fixed (default demo instant) | system (real UTC time; use for real-peers so verifier replay/age checks pass)
SIMULATOR_CLOCK=fixed

# Opaque bearer tokens mapped to local Principal records (sandbox only).
SIMULATOR_TOKEN_WORKFLOW=tok-workflow
SIMULATOR_TOKEN_VERIFIER=tok-verifier
SIMULATOR_TOKEN_DISPATCHER=tok-dispatcher
SIMULATOR_TOKEN_SANDBOX_ADMIN=tok-sandbox-admin

SIMULATOR_TENANT_ID=tenant-demo
SIMULATOR_SUBJECT_REF=subject-demo-42
SIMULATOR_CASE_ID=case-demo-42
SIMULATOR_MERCHANT_REF=merchant-demo-1

# Shared HMAC key with verifier (VERIFIER_WEBHOOK_HMAC_KEY must match).
# Original-byte HMAC-SHA256 → X-Sentinel-Signature (lowercase hex). Synthetic only.
SIMULATOR_WEBHOOK_HMAC_KEY=demo-simulator-hmac-key

# Non-loopback bind (0.0.0.0 / LAN IP) requires non-demo bearer tokens; loopback may keep tok-* defaults.
