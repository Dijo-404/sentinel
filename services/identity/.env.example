# Fixture mode uses in-memory store + seeded synthetic principals. No money peers.
IDENTITY_MODE=fixture
IDENTITY_CONTRACT_VERSION=sentinel.task-contracts.v1
IDENTITY_HOST=127.0.0.1
IDENTITY_PORT=8012
# Seed credential used only to hash fixture accounts at load time.
# Portal UI + deploy/dev use demo-password. Code default remains x if unset.
# Do not put real credentials here.
IDENTITY_DEMO_PASSWORD=demo-password
# Optional Postgres DSN for real storage adapter (not required for make check).
# IDENTITY_DATABASE_URL=postgresql+psycopg://identity:identity@127.0.0.1:5432/identity
# Non-loopback bind refuses demo passwords unless SENTINEL_SANDBOX_PUBLIC_BIND=1
# (labeled sandbox/dev-deploy only — see deploy/dev/CREDENTIALS.md).
# SENTINEL_SANDBOX_PUBLIC_BIND=1

# Product-demo sandbox: persist OTP to auth_delivery_log.sandbox_code + inbox GETs.
# Allowed with real-peers. Prefer this over EXPOSE for portal demos.
# IDENTITY_SANDBOX=1
# SENTINEL_V1_SANDBOX=1
# IDENTITY_SANDBOX_TOKEN=local-demo-token
# Module-check only: include sandbox_code in 202 verify/MFA/forgot responses.
# Must stay off for real-peers (refused at boot).
# IDENTITY_EXPOSE_SANDBOX_CODES=0

# Login: exact direct BFF/proxy socket IPs; empty default (no implicit loopback trust).
# Only configured peers may forward a validated rightmost X-Forwarded-For address.
# Missing/invalid forwarding from a configured BFF uses per-email failure fallback.
# Run alternate ASGI servers with --no-proxy-headers; see README for web ingress setup.
IDENTITY_TRUSTED_PROXIES=
